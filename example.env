# example.env

KEY=your_api_key_here

# Email alerts (optional) - see "Email alerts" in README.md
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
ALERT_FROM=jobs@yourdomain.com
ALERT_TO=you@gmail.com
TASK_TOKEN=a_long_random_string
